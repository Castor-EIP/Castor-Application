<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Studio"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Studio.PreviewPaneView"
             x:DataType="vm:StudioViewModel">

	<Panel Background="Black">

		<controls:StudioPreview Scene="{Binding ActiveScene}"
                                PreviewRuntime="{Binding PreviewRuntime}"
                                BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                Message="{Binding PreviewPlaceholderText}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />

		<!-- Recouvre StudioPreview quand rien ne peut être affiché -->
		<Border IsVisible="{Binding ShowPreviewPlaceholder}"
		        Classes="empty-state-box"
		        HorizontalAlignment="Center" VerticalAlignment="Center"
		        MaxWidth="420">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
				<TextBlock Text="APERÇU DU STUDIO"
                           Classes="empty-state-title"
                           LetterSpacing="1"/>
				<TextBlock Text="{Binding PreviewPlaceholderText}"
                           Classes="empty-state-desc"
                           MaxWidth="360"/>
			</StackPanel>
		</Border>
	</Panel>

</UserControl>
