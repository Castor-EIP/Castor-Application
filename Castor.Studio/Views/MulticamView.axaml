<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.MulticamView"
             x:DataType="vm:MulticamViewModel">

	<Grid RowDefinitions="56, Auto, *" Background="{DynamicResource AppBg}">

		<Border Grid.Row="0"
                Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
                Padding="16,0">
			<Grid ColumnDefinitions="*, Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
					<TextBlock Text="MULTI-CAMÉRAS"
                               FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AppFg1}"
                               VerticalAlignment="Center"/>
					<Border Background="{DynamicResource AppBadgeBg}" CornerRadius="10" Padding="8,3">
						<TextBlock Text="{Binding Scenes.Count, StringFormat='{}{0} scènes'}"
                                   FontSize="11" Foreground="{DynamicResource AppFg4}"/>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

					<!-- La disposition est un choix d'opérateur, pas un réglage enfoui : elle
					     change selon qu'on surveille toutes les caméras ou qu'on suit le direct. -->
					<Border Background="{DynamicResource AppBadgeBg}" CornerRadius="6" Padding="3">
						<StackPanel Orientation="Horizontal" Spacing="2">
							<Button IsVisible="{Binding IsGridLayout}" Content="GRILLE" Classes="ai-active"/>
							<Button IsVisible="{Binding !IsGridLayout}" Content="GRILLE"
                                    Command="{Binding UseGridLayoutCommand}" Classes="ai-mode"/>
							<Button IsVisible="{Binding IsSpotlightLayout}" Content="SPOTLIGHT" Classes="ai-active"/>
							<Button IsVisible="{Binding !IsSpotlightLayout}" Content="SPOTLIGHT"
                                    Command="{Binding UseSpotlightLayoutCommand}" Classes="ai-mode"/>
						</StackPanel>
					</Border>

					<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding IsGridLayout}">
						<TextBlock Text="Colonnes :" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource AppFg4}"/>
						<ComboBox SelectedIndex="{Binding ColumnChoice}" Width="88"
                                  VerticalAlignment="Center">
							<ComboBoxItem Content="Auto"/>
							<ComboBoxItem Content="1"/>
							<ComboBoxItem Content="2"/>
							<ComboBoxItem Content="3"/>
							<ComboBoxItem Content="4"/>
						</ComboBox>
					</StackPanel>

					<Button Content="ACTUALISER"
                            Command="{Binding RefreshTilesCommand}"
                            Background="{DynamicResource AppAccentBg}" Foreground="#5b8def"
                            BorderThickness="0" Padding="14,8" CornerRadius="6"
                            FontSize="12" FontWeight="SemiBold"
                            VerticalAlignment="Center" Cursor="Hand"/>
				</StackPanel>
			</Grid>
		</Border>

		<Border Grid.Row="1"
                Background="{DynamicResource AppSurface3}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
                Padding="16,10">
			<Grid ColumnDefinitions="Auto, *, Auto">

				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
					<TextBlock Text="IA :" Foreground="{DynamicResource AppFg3}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>

					<StackPanel Orientation="Horizontal" Spacing="6">
						<Button IsVisible="{Binding IsAiOff}"
                                Content="DÉSACTIVÉ"
                                Background="{DynamicResource AppBadgeBg}" Foreground="{DynamicResource AppFg3}"
                                BorderBrush="{DynamicResource AppBorder2}" BorderThickness="1"
                                Padding="12,6" CornerRadius="6"
                                FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
						<Button IsVisible="{Binding !IsAiOff}"
                                Content="DÉSACTIVÉ"
                                Command="{Binding SetAiOffCommand}"
                                IsEnabled="{Binding !IsAiBusy}"
                                Classes="ai-mode"/>

						<Button IsVisible="{Binding IsAiAgent}"
                                Content="MODE AGENT"
                                Classes="ai-active"/>
						<Button IsVisible="{Binding !IsAiAgent}"
                                Content="MODE AGENT"
                                Command="{Binding SetAiAgentCommand}"
                                IsEnabled="{Binding !IsAiBusy}"
                                Classes="ai-mode"/>

						<Button IsVisible="{Binding IsAiAuto}"
                                Content="MODE AUTO"
                                Classes="ai-active"/>
						<Button IsVisible="{Binding !IsAiAuto}"
                                Content="MODE AUTO"
                                Command="{Binding SetAiAutoCommand}"
                                IsEnabled="{Binding !IsAiBusy}"
                                Classes="ai-mode"/>
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
					<Ellipse Width="7" Height="7" Fill="{StaticResource StatusOkBrush}" VerticalAlignment="Center"
                             IsVisible="{Binding IsAiEnabled}"/>
					<TextBlock Text="{Binding AiStatusText}" Foreground="{DynamicResource AppFg3}"
                               FontSize="12" VerticalAlignment="Center"/>
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
					<TextBlock Text="Modèle IA :" Foreground="{DynamicResource AppFg4}"
                               FontSize="11" VerticalAlignment="Center"/>
					<ComboBox MinWidth="180"
                              SelectedIndex="{Binding SelectedAiModelIndex}"
                              IsEnabled="{Binding !IsAiEnabled}"
                              Background="{DynamicResource AppSurface2}" BorderBrush="{DynamicResource AppBorder2}" FontSize="12">
						<ComboBoxItem Content="Football"/>
						<ComboBoxItem Content="Podcast"/>
					</ComboBox>
				</StackPanel>

			</Grid>
		</Border>

		<Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="16">
			<Border Grid.Row="0"
                    IsVisible="{Binding AiError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#3b1219" BorderBrush="#7f1d1d" BorderThickness="1"
                    CornerRadius="6" Padding="10,7" Margin="0,0,0,12">
				<TextBlock Text="{Binding AiError}" Foreground="{StaticResource StatusErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
			</Border>

			<!-- Grille : toutes les scènes à la même taille. -->
			<ItemsControl Grid.Row="1" IsVisible="{Binding IsGridLayout}" ItemsSource="{Binding Tiles}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="{Binding GridColumns}"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:MulticamSceneTile">
							<Border Classes.onAir="{Binding IsOnAir}"
                                    DoubleTapped="OnTileDoubleTapped"
                                    ToolTip.Tip="Double-cliquer pour envoyer cette scène à l'antenne"
                                    Background="{DynamicResource AppSurface}"
                                    CornerRadius="8" Margin="0,0,10,10"
                                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
								<Border.Styles>
									<Style Selector="Border.onAir">
										<Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}"/>
										<Setter Property="BorderThickness" Value="2"/>
									</Style>
								</Border.Styles>
								<Grid RowDefinitions="Auto, *, Auto">

									<!-- Le titre et l'état live tiennent dans un bandeau réservé plutôt
									     qu'en surimpression : la surface native est une fenêtre enfant
									     Win32, Windows la compose au-dessus de tout ce qu'Avalonia
									     peint, donc rien posé sur la vidéo ne serait visible. -->
									<Border Grid.Row="0" Background="#0B0B12" Padding="10,6"
                                            CornerRadius="7,7,0,0">
										<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
											<Border IsVisible="{Binding IsOnAir}"
                                                    Background="{StaticResource StatusErrorBrush}"
                                                    CornerRadius="3" Padding="6,2"
                                                    VerticalAlignment="Center">
												<TextBlock Text="LIVE" Foreground="White"
                                                           FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
											</Border>
											<TextBlock Text="{Binding Name}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppFg1}"/>
										</StackPanel>
									</Border>

									<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
										<controls:StudioPreview Scene="{Binding Scene}"
                                                                PreviewRuntime="{Binding PreviewRuntime}"
                                                                BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                                                BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                                                Message="{Binding PreviewPlaceholderText}"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"/>
									</Panel>

									<Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *, Auto" Margin="10,8">
										<Border Grid.Column="0"
                                                IsVisible="{Binding IsAiSelected}"
                                                Background="{DynamicResource AppAccentFg}"
                                                CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
											<TextBlock Text="IA" Foreground="White"
                                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
										</Border>

										<Border Grid.Column="1"
                                                IsVisible="{Binding IsAiConsidered}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource AppAccentFg}" BorderThickness="1"
                                                CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
											<TextBlock Text="IA ?" Foreground="{DynamicResource AppAccentFg}"
                                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
										</Border>

										<TextBlock Grid.Column="2"
                                                   Text="{Binding SourceCount, StringFormat='{}{0} source(s)'}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppFg4}" FontSize="11"/>

										<CheckBox Grid.Column="3" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Inclure cette scène dans l'analyse IA"/>
									</Grid>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Spotlight : la scène à l'antenne en grand, les autres en bande.
			     Elle est rendue sur une surface qui lui est propre plutôt qu'en
			     empruntant sa tuile : un aperçu par fenêtre est précisément ce que
			     le runtime sait faire, et ça évite de tenir à jour une seconde
			     collection filtrée. -->
			<Grid Grid.Row="1" RowDefinitions="*, Auto" IsVisible="{Binding IsSpotlightLayout}">
				<Border Grid.Row="0"
                        Background="{DynamicResource AppSurface}"
                        CornerRadius="8" Margin="0,0,0,10"
                        BorderBrush="{StaticResource StatusErrorBrush}" BorderThickness="2">
					<Grid RowDefinitions="Auto, *">
						<Border Grid.Row="0" Background="#0B0B12" Padding="10,6" CornerRadius="7,7,0,0">
							<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
								<Border Background="{StaticResource StatusErrorBrush}"
                                        CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                                        IsVisible="{Binding SpotlightScene, Converter={x:Static ObjectConverters.IsNotNull}}">
									<TextBlock Text="LIVE" Foreground="White"
                                               FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
								</Border>
								<TextBlock Text="{Binding SpotlightScene.Name}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppFg1}"/>
							</StackPanel>
						</Border>

						<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
							<controls:StudioPreview Scene="{Binding SpotlightScene}"
                                                    PreviewRuntime="{Binding PreviewRuntime}"
                                                    BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                                    BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                                    Message="{Binding SpotlightPlaceholderText}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
						</Panel>
					</Grid>
				</Border>

				<ScrollViewer Grid.Row="1" Height="170" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding Tiles}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:MulticamSceneTile">
								<Border Width="240" Classes.onAir="{Binding IsOnAir}"
                                        DoubleTapped="OnTileDoubleTapped"
                                        ToolTip.Tip="Double-cliquer pour envoyer cette scène à l'antenne"
                                        Background="{DynamicResource AppSurface}"
                                        CornerRadius="8" Margin="0,0,10,0"
                                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
									<Border.Styles>
										<Style Selector="Border.onAir">
											<Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}"/>
											<Setter Property="BorderThickness" Value="2"/>
										</Style>
									</Border.Styles>
									<Grid RowDefinitions="*, Auto">
										<Panel Grid.Row="0" Background="Black" ClipToBounds="True">
											<controls:StudioPreview Scene="{Binding Scene}"
                                                                    PreviewRuntime="{Binding PreviewRuntime}"
                                                                    BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                                                    BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                                                    Message="{Binding PreviewPlaceholderText}"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Stretch"/>
										</Panel>
										<TextBlock Grid.Row="1" Text="{Binding Name}" Margin="10,6"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppFg1}"/>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Grid>

	</Grid>
</UserControl>
