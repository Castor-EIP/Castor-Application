<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Multicam"
             xmlns:controls="using:CastorApplication.Controls"
             x:Class="CastorApplication.Views.Multicam.MulticamTileView"
             xmlns:dockSettings="using:Dock.Settings"
             x:DataType="vm:MulticamSceneTile">

<Border Classes.onAir="{Binding IsOnAir}"
                                    dockSettings:DockProperties.IsDragEnabled="False"
                                    dockSettings:DockProperties.IsDropEnabled="False"
                                    DoubleTapped="OnTileDoubleTapped"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragOver="OnTileDragOver"
                                    DragDrop.Drop="OnTileDrop"
                                    ToolTip.Tip="Double-cliquer pour envoyer cette scène à l'antenne"
                                    Background="{DynamicResource AppSurface}"
                                    CornerRadius="8" Margin="0,0,10,10"
                                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
	<Border.Styles>
		<Style Selector="Border.onAir">
			<Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}"/>
			<Setter Property="BorderThickness" Value="2"/>
		</Style>
	</Border.Styles>
	<Grid RowDefinitions="Auto, *, Auto">

		<!-- Le titre et l'état live tiennent dans un bandeau réservé plutôt
		     qu'en surimpression : la surface native est une fenêtre enfant
		     Win32, Windows la compose au-dessus de tout ce qu'Avalonia
		     peint, donc rien posé sur la vidéo ne serait visible. -->
		<Border Grid.Row="0" Background="#0B0B12" Padding="10,6"
                                            CornerRadius="7,7,0,0"
                                            Cursor="SizeAll"
                                            PointerPressed="OnTileBandPointerPressed"
                                            ToolTip.Tip="Glisser pour réordonner les scènes">
			<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<Border IsVisible="{Binding IsOnAir}"
                                                    Background="{StaticResource StatusErrorBrush}"
                                                    CornerRadius="3" Padding="6,2"
                                                    VerticalAlignment="Center">
					<TextBlock Text="LIVE" Foreground="White"
                                                           FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
				</Border>
				<TextBlock Text="{Binding Name}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppFg1}"/>
			</StackPanel>
		</Border>

		<Panel Grid.Row="1" Background="Black" ClipToBounds="True">
			<controls:StudioPreview Scene="{Binding Scene}"
                                                                PreviewRuntime="{Binding PreviewRuntime}"
                                                                BaseCanvasWidth="{Binding BaseCanvasWidth}"
                                                                BaseCanvasHeight="{Binding BaseCanvasHeight}"
                                                                Message="{Binding PreviewPlaceholderText}"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Stretch"/>
		</Panel>

		<Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *, Auto" Margin="10,8">
			<Border Grid.Column="0"
                                                IsVisible="{Binding IsAiSelected}"
                                                Background="{DynamicResource AppAccentFg}"
                                                CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
				<TextBlock Text="IA" Foreground="White"
                                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
			</Border>

			<Border Grid.Column="1"
                                                IsVisible="{Binding IsAiConsidered}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource AppAccentFg}" BorderThickness="1"
                                                CornerRadius="3" Padding="6,2" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
				<TextBlock Text="IA ?" Foreground="{DynamicResource AppAccentFg}"
                                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"/>
			</Border>

			<TextBlock Grid.Column="2"
                                                   Text="{Binding SourceCount, StringFormat='{}{0} source(s)'}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppFg4}" FontSize="11"/>

			<CheckBox Grid.Column="3" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Inclure cette scène dans l'analyse IA"/>
		</Grid>
	</Grid>
</Border>

</UserControl>
