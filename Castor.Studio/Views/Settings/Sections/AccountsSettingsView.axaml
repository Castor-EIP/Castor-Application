<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CastorApplication.ViewModels.Settings.Sections"
             x:Class="CastorApplication.Views.Settings.Sections.AccountsSettingsView"
             x:DataType="vm:AccountsSettingsViewModel">

    <StackPanel Margin="28,20"
                Spacing="28">

        <StackPanel Spacing="14">

            <TextBlock Text="COMPTES"
                       Classes="section-title"/>

            <TextBlock Text="Connectez vos comptes de streaming pour diffuser directement depuis Castor."
                       Foreground="{DynamicResource AppFg4}"
                       FontSize="12"
                       Margin="0,0,0,4"/>

            <!-- Twitch -->
            <Border Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">

                        <Border CornerRadius="6"
                                Width="36"
                                Height="36"
                                ClipToBounds="True">

                            <Image Source="/Assets/twitch-logo.png"
                                   Width="36"
                                   Height="36"
                                   Stretch="UniformToFill"/>

                        </Border>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Twitch"
                                       Foreground="{DynamicResource AppFg1}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding TwitchStatus}"
                                       Foreground="{DynamicResource AppFg4}"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{Binding TwitchButtonText}"
                            Classes="platform-connect"
                            Command="{Binding ToggleTwitchCommand}"/>

                </Grid>

            </Border>

            <!-- YouTube (Bientôt disponible) -->
            <Border Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Opacity="0.75">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">

                        <Border CornerRadius="6"
                                Width="36"
                                Height="36"
                                ClipToBounds="True">

                            <Image Source="/Assets/youtube-logo.png"
                                   Width="36"
                                   Height="36"
                                   Stretch="UniformToFill"/>

                        </Border>

                        <StackPanel VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="YouTube Live"
                                           Foreground="{DynamicResource AppFg1}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource AppSurface2}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Bientôt disponible" FontSize="9"
                                               Foreground="{DynamicResource AppFg4}" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Diffusez en direct vers votre chaîne YouTube"
                                       Foreground="{DynamicResource AppFg4}"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Bientôt disponible"
                            Classes="platform-connect"
                            IsEnabled="False"
                            ToolTip.Tip="L'intégration YouTube Live sera disponible dans une prochaine mise à jour."/>

                </Grid>

            </Border>

            <!-- Facebook (Bientôt disponible) -->
            <Border Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Opacity="0.75">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12">

                        <Border CornerRadius="6"
                                Width="36"
                                Height="36"
                                ClipToBounds="True">

                            <Image Source="/Assets/facebook-logo.png"
                                   Width="36"
                                   Height="36"
                                   Stretch="UniformToFill"/>

                        </Border>

                        <StackPanel VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Facebook Live"
                                           Foreground="{DynamicResource AppFg1}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <Border Background="{DynamicResource AppSurface2}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Bientôt disponible" FontSize="9"
                                               Foreground="{DynamicResource AppFg4}" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Diffusez en direct vers vos pages et groupes Facebook"
                                       Foreground="{DynamicResource AppFg4}"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Bientôt disponible"
                            Classes="platform-connect"
                            IsEnabled="False"
                            ToolTip.Tip="L'intégration Facebook Live sera disponible dans une prochaine mise à jour."/>

                </Grid>

            </Border>

        </StackPanel>

    </StackPanel>

</UserControl>
