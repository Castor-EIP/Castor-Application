<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:CastorApplication.ViewModels.Settings"
             x:Class="CastorApplication.Views.Settings.Components.SettingsNavItem"
             x:DataType="settings:SettingsSectionItem">

	<Button Classes="settings-nav-btn"
	        Classes.selected="{Binding IsSelected}"
	        Command="{Binding SelectCommand}"
	        CommandParameter="{Binding}">
		<Grid ColumnDefinitions="3, *">
			<Border Grid.Column="0"
			        Background="{DynamicResource AppAccentFg}"
			        CornerRadius="1.5"
			        Height="18"
			        VerticalAlignment="Center"
			        IsVisible="{Binding IsSelected}"/>
			<TextBlock Grid.Column="1"
			           Text="{Binding Title}"
			           Margin="12,0,0,0"
			           VerticalAlignment="Center"
			           FontSize="13"/>
		</Grid>
	</Button>

</UserControl>